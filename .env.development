# Non-sensitive development defaults. Sensitive values (CLIENT_APPLICATION_*,
# NEXTAUTH_SECRET) belong in a gitignored `.env.local`. See `.env.example`.

DATABASE_URL="postgresql://orbit:orbit@localhost:5432/orbit_development?schema=public"

GRAVITY_URL="https://stagingapi.artsy.net"
PUBLIC_GRAVITY_URL="https://stagingapi.artsy.net"

NEXTAUTH_URL="http://localhost:3000"
