# Non-sensitive defaults for the `hokusai test` container (runs `yarn test`).
# Jest mocks Prisma, so no real database is contacted — these just satisfy the
# code paths that read env vars at import time.

NODE_ENV="test"

DATABASE_URL="postgresql://orbit:orbit@localhost:5432/orbit_test?schema=public"

GRAVITY_URL="https://stagingapi.artsy.net"
PUBLIC_GRAVITY_URL="https://stagingapi.artsy.net"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="test-secret-not-used-in-production"
