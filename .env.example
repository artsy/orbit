##############################################################################
# Copy to `.env.local` and fill in the blanks. `.env.local` is gitignored.
##############################################################################

# --- Database (matches docker-compose.yml) -------------------------------
DATABASE_URL="postgresql://orbit:orbit@localhost:5433/orbit_development?schema=public"

# --- Auth: Artsy / Gravity OAuth (next-auth) -----------------------------
# Obtain a ClientApplication id/secret from Gravity. See:
# https://github.com/artsy/gravity/blob/main/doc/ApiAuthentication.md
CLIENT_APPLICATION_ID=""
CLIENT_APPLICATION_SECRET=""

# Gravity base URL (staging shown; use production when appropriate)
GRAVITY_URL="https://stagingapi.artsy.net"

# next-auth: the canonical URL of this app + a random secret.
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# --- Client-exposed vars (must be prefixed PUBLIC_) -----------------------
PUBLIC_GRAVITY_URL="https://stagingapi.artsy.net"
