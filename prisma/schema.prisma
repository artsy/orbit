// Orbit — engineer rotation schema.
// This schema is the shared data contract for all work packages.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Engineer {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  // Slack user ID (e.g. "U01427GSPK9") — stable identifier used to @mention the
  // engineer (unlike a handle, it doesn't change if the person renames).
  slackUserId String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  memberships          RotationMember[]
  teamMemberships      TeamMember[]
  replacementOverrides Override[]       @relation("ReplacementEngineer")
  originalOverrides    Override[]       @relation("OriginalEngineer")
}

// A named group of engineers (e.g. "Frontend"), independent of any rotation —
// used purely as a convenience for bulk-adding its members to a rotation's
// on-call order. Membership is unordered (unlike RotationMember, which has a
// `position`), and there's no relation to Rotation: adding a team creates
// ordinary RotationMember rows with no lasting link back to the team.
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members TeamMember[]
}

model TeamMember {
  id         String @id @default(cuid())
  teamId     String
  engineerId String

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  engineer Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([teamId, engineerId])
}

model Rotation {
  id          String   @id @default(cuid())
  name        String
  // Optional free-text description of the rotation's purpose.
  description String?
  // Length of one on-call period in days (weekly = 7).
  cadenceDays Int      @default(7)
  // Start of period 0. The round-robin is computed relative to this instant.
  anchorDate  DateTime
  timezone    String   @default("America/New_York")
  createdAt   DateTime @default(now())

  members   RotationMember[]
  overrides Override[]
}

model RotationMember {
  id         String @id @default(cuid())
  rotationId String
  engineerId String
  // Zero-based order within the rotation's round-robin.
  position   Int

  rotation Rotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  engineer Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([rotationId, engineerId])
  @@unique([rotationId, position])
}

model Override {
  id                    String   @id @default(cuid())
  rotationId            String
  // Inclusive date range this override covers.
  startDate             DateTime
  endDate               DateTime
  replacementEngineerId String
  // Snapshot of who the base rotation had on-call when the override was created.
  originalEngineerId    String?
  reason                String?
  createdByEmail        String
  // Links the two reciprocal rows produced by a shift swap.
  swapGroupId           String?
  createdAt             DateTime @default(now())

  rotation            Rotation  @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  replacementEngineer Engineer  @relation("ReplacementEngineer", fields: [replacementEngineerId], references: [id])
  originalEngineer    Engineer? @relation("OriginalEngineer", fields: [originalEngineerId], references: [id])

  @@index([rotationId, startDate, endDate])
  @@index([swapGroupId])
}

// An append-only audit trail of mutations across the app (who did what,
// when). Deliberately has no relations/FKs to Rotation/Engineer/Override —
// those all cascade-delete aggressively, and history should survive the
// thing it describes being deleted. `rotationId`/`rotationName` are a
// denormalized snapshot for optional filtering/linking, not a foreign key.
model Event {
  id           String   @id @default(cuid())
  // e.g. "rotation.created", "override.deleted" — see EventAction in utils/api/events.ts
  action       String
  // Human-readable one-liner, e.g. `Added override for Jane Doe on "Platform on-call"`
  summary      String
  actorEmail   String
  rotationId   String?
  rotationName String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([rotationId])
}
